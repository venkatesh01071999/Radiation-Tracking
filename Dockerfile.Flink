FROM apache/flink:1.18-scala_2.12-java11

# Install Python and pip
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    python3-minimal python3-pip && \
    rm -rf /var/lib/apt/lists/*

# Set python3 as default when using python command
RUN ln -s /usr/bin/python3 /usr/bin/python

# Set working dir
WORKDIR /opt/flink_app

# Copy flink folder
COPY app/flink .

# Install required Python packages
RUN pip install -r requirements.txt

# Copy jar files to Flink lib directory
COPY app/flink/kafka-clients-3.5.1.jar /opt/flink/lib/
COPY app/flink/flink-connector-kafka-3.0.1-1.18.jar /opt/flink/lib/